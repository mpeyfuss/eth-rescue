# Copy to .env. Forge reads these through foundry.toml; make reads ACCOUNT and SENDER.

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
# Used by make verify-*; Etherscan v2 keys work for every chain.
ETHERSCAN_API_KEY=

# Signer: set at most one. Neither set means --trezor on its first address.
# SENDER: the Trezor address to sign with (--trezor --sender $SENDER).
SENDER=
# ACCOUNT: a foundry keystore name from `cast wallet import <name> --interactive`.
# ACCOUNT=deployer
